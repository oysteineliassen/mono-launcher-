                <action android:name="no.oystein.launcher.TEST_DELIVERY" />
                <action android:name="no.oystein.launcher.TEST_BACKUP" />
                <action android:name="no.oystein.launcher.TEST_NEXT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
